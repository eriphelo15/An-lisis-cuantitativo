# Copia este archivo como .env (nunca subas .env al repositorio).

# La SEC exige identificarse con nombre y email en cada consulta.
HERMES_SEC_USER_AGENT="Hermes tu-email@ejemplo.com"

# API key gratuita de Massive (antes Polygon.io): https://massive.com
MASSIVE_API_KEY=

# Opcional: dominio de la API de Massive y carpeta de datos locales.
# MASSIVE_BASE_URL=https://api.polygon.io
# HERMES_DATOS=./datos
