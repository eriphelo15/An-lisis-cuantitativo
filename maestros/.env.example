# Copia este archivo como .env (nunca subas .env al repositorio).

# La SEC exige identificarse con nombre y email en cada consulta.
MAESTROS_SEC_USER_AGENT="Maestros tu-email@ejemplo.com"

# Alpaca (cuenta gratuita): barras de 1 minuto, noticias y paper trading. https://alpaca.markets
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Massive (antes Polygon.io), plan gratuito: barras diarias de todo el mercado. https://massive.com
MASSIVE_API_KEY=

# Opcional
# MASSIVE_BASE_URL=https://api.polygon.io
# MAESTROS_DATOS=./datos
